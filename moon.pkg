import {
  "moonbit-community/bashcheck/checker",
  "moonbit-community/bashcheck/driver",
  "moonbit-community/bashcheck/formatter",
  "moonbit-community/bashcheck/semantics",
  "moonbitlang/async",
  "moonbitlang/core/env",
}

import {
  "moonbitlang/core/debug",
} for "test"

import {
  "moonbitlang/core/test",
} for "wbtest"

supported_targets = "wasm+native"

pkgtype(kind: "executable")
